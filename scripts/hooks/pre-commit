#!/usr/bin/env bash
# arbcn pre-commit gate（AGENTS.md §7）。禁 --no-verify 绕过。
# D-014 细化：只拦历史标记行（✅/⬜/🔄/决策头/纪要头），计数制（净减少才拦）；
# AGENTS.md 不在此守卫范围（其变更控制 = decisions.md + git）。
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
MARKER='✅|⬜|🔄|^##[[:space:]]+(D-[0-9]{3}|#[0-9]+)'
PROTECTED="docs/handoff/STATE.md docs/handoff/decisions.md docs/handoff/practices.md docs/handoff/dialogue.md docs/handoff/LOG.md"

echo "── arbcn pre-commit ──"

if [ "$(git config core.hooksPath)" != "scripts/hooks" ]; then
  echo "❌ 未注册 hooks。执行: git config core.hooksPath scripts/hooks"
  exit 1
fi

# 首次提交（无 HEAD）：保护文件均为新增，历史守卫自下个提交生效
if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
  echo "✅ 首提交放行"
  exit 0
fi

# 1) 业务代码提交必须伴随 STATE.md 更新（§6.3 收工必写）
code_changed="$(git diff --cached --name-only | grep -vE '^(docs/|AGENTS\.md$|\.gitignore$|scripts/)' || true)"
state_changed="$(git diff --cached --name-only | grep -c '^docs/handoff/STATE\.md$' || true)"
if [ -n "$code_changed" ] && [ "$state_changed" -eq 0 ]; then
  echo "❌ 提交含业务代码但 STATE.md 未更新（§6.3）。先更新 STATE.md 再提交。"
  exit 1
fi

# 2) 历史标记删除守卫（计数制；归档轮转豁免：同 commit 新增 LOG.md）
for f in $PROTECTED; do
  [ -f "$ROOT/$f" ] || continue
  del_n="$(git diff --cached -U0 -- "$f" | grep -E '^-[^-]' | sed 's/^-//' | grep -cE "$MARKER" || true)"
  add_n="$(git diff --cached -U0 -- "$f" | grep -E '^\+[^+]' | sed 's/^\+//' | grep -cE "$MARKER" || true)"
  if [ "$del_n" -gt "$add_n" ]; then
    log_gain="$(git diff --cached -U0 -- docs/handoff/LOG.md | grep -E '^\+[^+]' | wc -l || true)"
    if [ "$log_gain" -eq 0 ]; then
      echo "❌ $f 历史标记净减少（-$del_n +$add_n）。历史标记只能经归档轮转（同 commit LOG.md 有新增内容）移除。"
      exit 1
    fi
  fi
done

# 3) 文件规模门禁（§7.3 C：>450 阻断 / >300 警告；生成代码与测试豁免）
if ! "$ROOT/scripts/check-lines.sh"; then
  echo "❌ check-lines 未过"
  exit 1
fi

echo "✅ 通过"
exit 0
