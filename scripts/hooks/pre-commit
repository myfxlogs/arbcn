#!/usr/bin/env bash
# arbcn pre-commit gate（AGENTS.md §7）。禁 --no-verify 绕过。
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
PROTECTED="AGENTS.md docs/handoff/STATE.md docs/handoff/decisions.md docs/handoff/practices.md docs/handoff/dialogue.md docs/handoff/LOG.md"

echo "── arbcn pre-commit ──"

if [ "$(git config core.hooksPath)" != "scripts/hooks" ]; then
  echo "❌ 未注册 hooks。执行: git config core.hooksPath scripts/hooks"
  exit 1
fi

# 首次提交（无 HEAD）：保护文件均为新增，历史守卫自下个提交生效
if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
  echo "✅ 首提交放行"
  exit 0
fi

# 1) 业务代码提交必须伴随 STATE.md 更新（§6.3 收工必写）
code_changed="$(git diff --cached --name-only | grep -vE '^(docs/|AGENTS\.md$|\.gitignore$|scripts/)' || true)"
state_changed="$(git diff --cached --name-only | grep -c '^docs/handoff/STATE\.md$' || true)"
if [ -n "$code_changed" ] && [ "$state_changed" -eq 0 ]; then
  echo "❌ 提交含业务代码但 STATE.md 未更新（§6.3）。先更新 STATE.md 再提交。"
  exit 1
fi

# 2) 保护文件历史标记删除守卫（归档轮转豁免：同 commit 新增 LOG.md）
for f in $PROTECTED; do
  [ -f "$ROOT/$f" ] || continue
  deleted="$(git diff --cached -U0 -- "$f" | grep -E '^-[^-]' || true)"
  if [ -n "$deleted" ]; then
    archive_added="$(git diff --cached --name-status -- docs/handoff/LOG.md | grep -c '^A' || true)"
    if [ "$archive_added" -eq 0 ]; then
      echo "❌ 保护文件 $f 有删除行。历史标记只能经归档轮转（同 commit 新增 LOG.md）或文档化裁剪删除。"
      exit 1
    fi
  fi
done

echo "✅ 通过"
exit 0
